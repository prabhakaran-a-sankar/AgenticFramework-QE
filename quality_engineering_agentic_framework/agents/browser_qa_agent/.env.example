# ── LLM Provider ─────────────────────────────────────────────────────────────
# Choose one: anthropic | openai | azure_openai | gemini | ollama
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI
OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o

# Azure OpenAI
# LLM_PROVIDER=azure_openai
# OPENAI_API_KEY=<azure-key>
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-02-15-preview
# LLM_MODEL=gpt-4o

# Google Gemini
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=...
# LLM_MODEL=gemini-1.5-pro-latest

# Ollama (local, no API key needed)
# LLM_PROVIDER=ollama
# LLM_MODEL=llava
# OLLAMA_BASE_URL=http://localhost:11434

MAX_AGENT_STEPS=30

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./qa_agent.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/qa_agent

# ── Redis (Celery) ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Artifact Storage ──────────────────────────────────────────────────────────
STORAGE_BACKEND=local           # local | s3
STORAGE_LOCAL_PATH=./artifacts

# S3 / R2 / MinIO / GCS (only when STORAGE_BACKEND=s3)
S3_BUCKET=qa-artifacts
S3_ENDPOINT_URL=                # blank=AWS; https://xxx.r2.cloudflarestorage.com for R2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ── GitHub App ────────────────────────────────────────────────────────────────
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# ── Slack ─────────────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8080
SECRET_KEY=change-me-in-production
